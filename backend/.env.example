# Copiar este archivo con el nombre ".env" y ajustar los valores.

# Puerto donde escucha el backend
PORT=3000

# --- Base de datos SQL Server ---
# Nombre del servidor/instancia (el mismo que se usa para entrar a SSMS)
DB_SERVIDOR=.\SQLEXPRESS
DB_NOMBRE=HospitalDB
# "windows" = Autenticación de Windows (no pide usuario ni contraseña)
# "sql"     = Autenticación de SQL Server (completar DB_USUARIO y DB_PASSWORD)
DB_AUTENTICACION=windows
DB_USUARIO=
DB_PASSWORD=
# Driver ODBC instalado en la PC (ver "Orígenes de datos ODBC" de Windows)
DB_DRIVER_ODBC=ODBC Driver 17 for SQL Server

# --- Seguridad ---
# Clave con la que se firman los tokens JWT. Poner un texto largo y aleatorio.
JWT_SECRETO=cambiar-por-un-texto-largo-y-secreto
JWT_DURACION=8h

# URL del frontend (para permitirle hacer peticiones al backend)
FRONTEND_URL=http://localhost:5173
